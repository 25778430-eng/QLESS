generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

// Basic shops list without documents but can't take deposits. Verified shops can.
enum VendorLevel {
  BASIC
  VERIFIED
}

enum DocKind {
  ID
  ADDRESS
  BANK
  CIPC
  SELFIE
  SHOPFRONT
}

enum DocStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QueueStatus {
  OPEN
  PAUSED
  CLOSED
}

enum BookingStatus {
  PENDING_PAYMENT
  WAITING
  CALLED
  IN_SERVICE
  DONE
  NO_SHOW
  CANCELLED
}

enum DepositStatus {
  NONE
  PAID
  APPLIED
  REFUND_PENDING
  REFUNDED
  FORFEITED
}

model User {
  id               String    @id @default(cuid())
  phone            String    @unique
  name             String
  email            String?
  role             Role      @default(CUSTOMER)
  // A super admin is an ADMIN who can also manage other admins, fees, plans, featured listings and Money.
  // Numbers in ADMIN_PHONES are always super admins.
  superAdmin       Boolean   @default(false)
  consentReminders Boolean   @default(false)
  consentOffers    Boolean   @default(false)
  consentAt        DateTime?
  notifySms        Boolean   @default(true)
  notifyWhatsapp   Boolean   @default(true)
  lowData          Boolean   @default(false)
  // App language: en, zu, xh, af, st. See src/lib/i18n.ts.
  lang             String    @default("en")
  blockedUntil     DateTime?
  // Set by the admin. A banned user is signed out, cannot sign in, and their shop is hidden.
  banned           Boolean   @default(false)
  bannedReason     String?
  createdAt        DateTime  @default(now())

  sessions Session[]
  pushSubs PushSubscription[]
  vendor   Vendor?
  bookings Booking[]
  reviews  Review[]
}

model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vendor {
  id               String       @id @default(cuid())
  ownerId          String       @unique
  name             String
  slug             String       @unique
  // Short code printed under the QR poster. Customers type it on Scan if their camera won't scan.
  code             String?      @unique
  category         String
  // SALON, CAR_WASH, CLINIC, REPAIR, PRIVATE or GOVERNMENT. Sets the wording and which tools the shop gets.
  businessType     String       @default("SALON")
  // Optional when the admin has switched the CIPC requirement off.
  cipc             String?
  level            VendorLevel  @default(VERIFIED)
  // A Basic shop that has asked to become Verified.
  upgradeRequested Boolean      @default(false)
  bankName         String?
  bankAccountName  String?
  bankAccountNo    String?
  address          String
  lat              Float?
  lng              Float?
  phone            String
  status           VendorStatus @default(PENDING)
  rejectReason     String?
  depositCents     Int          @default(5000)
  refundWindowMins Int          @default(120)
  // Seven characters, Monday first: "1111110" means open Mon to Sat.
  openDays         String       @default("1111110")
  openTime         String       @default("08:00")
  closeTime        String       @default("18:00")
  createdAt        DateTime     @default(now())
  approvedAt       DateTime?
  // Monthly plan. planPaidUntil moves forward with each PayFast subscription payment.
  planWaived       Boolean      @default(false)
  planPaidUntil    DateTime?
  planToken        String?
  planAmountCents  Int?
  // Featured listing, set by the admin. Higher rank shows first.
  featured         Boolean      @default(false)
  featuredRank     Int          @default(0)
  featuredUntil    DateTime?
  // Secret part of the waiting-room TV link. Reset by the owner to stop an old screen.
  tvKey            String?

  owner     User       @relation(fields: [ownerId], references: [id])
  staff     Staff[]
  services  Service[]
  photos    Photo[]
  queueDays QueueDay[]
  bookings  Booking[]
  reviews   Review[]
  income    Income[]
  documents Document[]
  payouts   Payout[]
}

model Staff {
  id       String    @id @default(cuid())
  vendorId String
  name     String
  // Staff sign in with this number to use their own chair screen.
  phone    String?
  active   Boolean   @default(true)
  // Own working hours, set by the owner. Same format as Vendor.openDays; blank times mean the shop's hours.
  workDays   String    @default("1111111")
  startTime  String?
  endTime    String?
  lunchStart String?
  lunchEnd   String?
  // Set while this staff member is on a short break. Their chair's clients move back until then.
  breakUntil DateTime?
  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([phone])
}

// Files a vendor hands in for verification. The file itself is wiped 90 days after review (POPIA).
model Document {
  id         String    @id @default(cuid())
  vendorId   String
  kind       DocKind
  fileName   String
  mime       String
  data       Bytes?
  status     DocStatus @default(PENDING)
  note       String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, kind])
}

model Service {
  id           String    @id @default(cuid())
  vendorId     String
  name         String
  durationMins Int
  priceCents   Int
  // Price options, e.g. car sizes: [{ "label": "Small car", "priceCents": 8000, "durationMins": 30 }]. Empty means one price.
  options      Json      @default("[]")
  // An extra or product added on to a service (wax, sanitiser, a bottle of oil), not a visit on its own.
  isExtra      Boolean   @default(false)
  // Letter in front of ticket numbers for this service, e.g. "A" gives A027.
  ticketLetter String?
  // What to bring, shown before joining (mainly government offices).
  bring        String    @default("")
  active       Boolean   @default(true)
  vendor       Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookings     Booking[]
}

model Photo {
  id        String   @id @default(cuid())
  vendorId  String
  caption   String   @default("")
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model QueueDay {
  id          String      @id @default(cuid())
  vendorId    String
  // Local date in Africa/Johannesburg, YYYY-MM-DD.
  date        String
  staffIds    String[]
  capacity    Int
  status      QueueStatus @default(OPEN)
  pausedUntil DateTime?
  pauseReason String?
  openedAt    DateTime    @default(now())
  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@unique([vendorId, date])
}

model Booking {
  id               String        @id @default(cuid())
  ref              String        @unique
  vendorId         String
  queueDayId       String
  customerId       String?
  walkInName       String?
  isWalkIn         Boolean       @default(false)
  serviceId        String
  staffId          String?
  position         Float
  status           BookingStatus
  checkInCode      String
  arrived          Boolean       @default(false)
  movedBack        Boolean       @default(false)
  priceCents       Int
  // The chosen price option and add-ons. priceCents already includes them.
  optionLabel      String?
  durationMins     Int?
  extras           String        @default("")
  extrasCents      Int           @default(0)
  // Number shown on screens and printed tickets, e.g. A027 or 014.
  ticketNo         String?
  // Booked for a set time on a later day instead of joining today's queue.
  scheduledAt      DateTime?
  // Walk-ins can leave a number to get their ticket by SMS.
  walkInPhone      String?
  // Car washes: number plate. Repairs: what is being fixed.
  plate            String?
  item             String?
  // Repair job stage: RECEIVED, CHECKING, QUOTE, WORKING, READY. A quote needs the customer's yes.
  jobStage         String?
  quoteCents       Int?
  quoteNote        String?
  quoteApproved    Boolean?
  readyAt          DateTime?
  depositCents     Int
  depositStatus    DepositStatus @default(NONE)
  // Qless booking fee paid on top of the deposit. Kept by Qless, never refunded.
  feeCents         Int           @default(0)
  payfastPaymentId String?
  reminded60       Boolean       @default(false)
  reminded20       Boolean       @default(false)
  calledAt         DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime      @default(now())

  vendor   Vendor   @relation(fields: [vendorId], references: [id])
  queueDay QueueDay @relation(fields: [queueDayId], references: [id])
  customer User?    @relation(fields: [customerId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])
  staff    Staff?   @relation(fields: [staffId], references: [id])
  review   Review?

  @@index([queueDayId, status])
  @@index([customerId, status])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  vendorId   String
  customerId String
  rating     Int
  text       String   @default("")
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id])
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  customer   User     @relation(fields: [customerId], references: [id])
}

// App-wide settings, one row with id "global". Changed by the admin.
model Setting {
  id              String    @id @default("global")
  bookingFeeOn    Boolean   @default(false)
  bookingFeeCents Int       @default(500)
  planOn          Boolean   @default(false)
  planOnSince     DateTime?
  planPriceCents  Int       @default(14900)
  planTrialDays   Int       @default(14)
  // Vendor sign-up rules
  allowBasic      Boolean   @default(true)
  requireCipc     Boolean   @default(true)
  requireAddress  Boolean   @default(true)
  requireBank     Boolean   @default(true)
  // Business types switched off by the super admin. Their shops are hidden and can't sign up.
  disabledTypes   String[]  @default(["GOVERNMENT"])
  // Last run of the daily POPIA clean-up.
  cleanupAt       DateTime?
  updatedAt       DateTime  @updatedAt
}

enum IncomeKind {
  PLAN
  FEATURED
}

// Money Qless earns from vendors. Booking fees are read from bookings instead.
model Income {
  id          String     @id @default(cuid())
  kind        IncomeKind
  vendorId    String
  amountCents Int
  note        String     @default("")
  createdAt   DateTime   @default(now())
  vendor      Vendor     @relation(fields: [vendorId], references: [id])

  @@index([createdAt])
}

// Money Qless paid out to a vendor (deposits it collected for them). Recorded by a super admin.
model Payout {
  id          String   @id @default(cuid())
  vendorId    String
  amountCents Int
  reference   String   @default("")
  createdAt   DateTime @default(now())
  createdBy   String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  @@index([vendorId, createdAt])
}
