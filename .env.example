# Database (PostgreSQL)
DATABASE_URL="postgresql://qless:qless@localhost:5432/qless"

# Public URL of the app, used in QR codes, PayFast return links and messages
APP_URL="http://localhost:3000"

# Long random string used to sign sessions and hash OTP codes
AUTH_SECRET="change-me-to-a-long-random-string"

# Phone numbers (E.164, comma separated) that get the admin role when they sign in
ADMIN_PHONES="+27820000000"

# Twilio: SMS and WhatsApp. Leave blank in development to print messages to the console.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""

# PayFast: deposits and refunds. Leave blank in development to use the built-in test payment.
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
# "true" uses sandbox.payfast.co.za
PAYFAST_SANDBOX="true"

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@qless.co.za"

# Protects /api/cron/tick, which sends reminders and expires no-shows. Call it every minute.
CRON_SECRET="change-me"
